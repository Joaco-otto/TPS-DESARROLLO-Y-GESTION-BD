-- A nivel técnico, la que sigue es una consulta estándar para auditar la asignación de permisos por roles
SELECT		rol.name [rol],
			usuario.name [usuario],
			drm.*
FROM		sys.database_role_members [drm]
JOIN		sys.database_principals [rol] ON drm.role_principal_id=rol.principal_id
