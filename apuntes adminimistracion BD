*/

/* 
PRINCIPIO DE MÍNIMO PRIVILEGIO Y SEPARACIÓN DE RESPONSABILIDADES

El principio de mínimo privilegio indica que un usuario debe tener solamente los permisos necesarios para 
cumplir su tarea.
No se deben dar permisos “por las dudas”, porque eso aumenta el riesgo de errores, modificaciones indebidas o 
pérdida de control.
Por ejemplo, si un vendedor solo necesita consultar clientes e insertar ventas, no debería poder borrar 
registros, modificar clientes ni administrar la base.
También es importante separar responsabilidades. 
No todos los perfiles hacen lo mismo:
- un vendedor opera ventas
- un supervisor revisa y corrige ciertos datos
- un auditor consulta información
- un administrador gestiona accesos y configuración
Separar responsabilidades ayuda a proteger los datos y a reducir errores humanos.*/

-- el usuario no debería poder crear tablas
CREATE TABLE dbo.PruebaVendedor(
	id INT
);
GO

-- permisos a nivel columna
-- Permitir SELECT solo sobre algunas columnas
-- nos conectamos como sa
USE Comercio;

-- primero quitamos el SELECT general sobre toda la tabla Clientes
REVOKE SELECT on dbo.Clientes from rol_vendedor;

-- otorgamos SELECT solo sobre columnas específicas
GRANT SELECT (id_cliente, nombre, activo)
ON dbo.Clientes TO rol_vendedor;

-- nos conectamos como vendedor_login
USE Comercio;
SELECT * FROM Clientes; -- error, el rol no puede ver todo 
SELECT email FROM Clientes; -- no puede ver el campo email
SELECT id_cliente, nombre, activo FROM Clientes;


-- nos conectamos como sa
-- quitamos los permisos específicos por columna
USE Comercio;
GO
REVOKE SELECT (id_cliente, nombre, activo)
ON dbo.Clientes FROM rol_vendedor;

-- nos conectamos con vendedor_login
USE Comercio;
SELECT * FROM Clientes; -- no tiene acceso a los campos de la tabla con el SELECT
SELECT id_cliente, nombre, activo FROM Clientes; -- ni siquiera a estos campos

-- nos conectamos como sa
USE Comercio;
GO
GRANT SELECT ON dbo.Clientes TO rol_vendedor;












