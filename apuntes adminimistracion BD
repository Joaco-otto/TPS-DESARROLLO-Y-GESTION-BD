-- Vamos a trabajar dentro de la base comercio
-- Los roles de base de datos existen dentro de una base específica
USE Comercio;
GO

-- comprobamos login, user y base
SELECT	SUSER_NAME() [login],
		USER_NAME() [user],
		DB_NAME() [base];

-- Creamos un rol para el perfil vendedor.
-- Un rol es un agrupador de permisos.
-- En lugar de dar permisos directamente al usuario, se los vamos a dar al rol.
CREATE ROLE rol_vendedor; -- el rol solo está creado, no tiene permisos ni miembros

-- verificamos que el rol fue creado dentro de la base Comercio
SELECT		NAME,
			TYPE_DESC, -- muestra la descripción textual del tipo de principal de seguridad dentro de la BD
			CREATE_DATE,
			DB_NAME() [base actual]
FROM		sys.database_principals -- muestra las identidades de seguridad dentro de la base actual
WHERE		NAME = 'rol_vendedor';

-- agregamos al user vendedor_login al rol rol_vendedor
